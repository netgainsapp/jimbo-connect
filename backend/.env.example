MONGO_URL=mongodb://localhost:27017
DB_NAME=jimbo_connect
# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never deploy with a placeholder: a known signing key lets anyone forge tokens.
JWT_SECRET=
# REQUIRED to bootstrap the single platform admin. If ADMIN_PASSWORD is unset,
# admin bootstrap is skipped (no guessable default is used).
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3000

# Resend (transactional email). Leave blank to fall back to in-app reset URL.
RESEND_API_KEY=
EMAIL_FROM=Intro Connect <hello@intro-connect.com>

# CAN-SPAM / deliverability.
# Signing secret for Resend webhooks (resend.com -> Webhooks, starts with whsec_).
# Leave blank to disable the /api/webhooks/resend endpoint entirely.
RESEND_WEBHOOK_SECRET=
# Public base URL of this API, used to build absolute unsubscribe links.
API_PUBLIC_URL=https://jimbo-connect-api-rdkp.onrender.com
# Optional dedicated secret for signing unsubscribe links (falls back to JWT_SECRET).
UNSUBSCRIBE_SECRET=

# Signal Scout error hub (report-only key; blank = reporting disabled)
ERROR_HUB_KEY=

# Stripe billing. All blank = billing dormant (checkout returns not-enabled,
# webhook 401s, everyone stays on the free plan). To enable:
STRIPE_SECRET_KEY=            # sk_live_... (or sk_test_...)
STRIPE_WEBHOOK_SECRET=        # whsec_... from Stripe -> Developers -> Webhooks
STRIPE_PRICE_STARTER=         # price_... for the $39/mo Starter subscription
STRIPE_PRICE_PRO=             # price_... for the $99/mo Pro subscription
# Set false for an early-access window where everyone is unlimited regardless of
# plan. Default true = free plan limited to 1 event (current behavior).
BILLING_ENFORCED=true
